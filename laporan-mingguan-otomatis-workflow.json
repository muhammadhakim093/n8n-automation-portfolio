      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\nconst oneWeekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);\n\n// Helper: ambil value field tanpa peduli spasi di nama kolom\nfunction getField(json, fieldName) {\n  const key = Object.keys(json).find(k => k.trim() === fieldName);\n  return key ? json[key] : undefined;\n}\n\nconst leadsMingguIni = items.filter(item => {\n  const tanggalLead = new Date(getField(item.json, 'Timestamp'));\n  return tanggalLead >= oneWeekAgo;\n});\n\nconst totalLead = leadsMingguIni.length;\nconst leadPrioritas = leadsMingguIni.filter(i => getField(i.json, 'Status') === 'Lead Prioritas').length;\nconst totalEstimasi = leadsMingguIni.reduce((sum, i) => sum + Number(getField(i.json, 'Estimasi Min') || 0), 0);\n\nreturn [{\n  json: {\n    totalLead,\n    leadPrioritas,\n    leadEdukasi: totalLead - leadPrioritas,\n    totalEstimasi\n  }\n}];"
      },
